            "output": "smtp.pass: [REDACTED]"
        },
        {
            "input": "REDIS_PASS=hunter2",
            "output": "REDIS_PASS=[REDACTED]"
        },
        {
            "input": "AUTH_KEY=abc",
            "output": "AUTH_KEY=[REDACTED]"
