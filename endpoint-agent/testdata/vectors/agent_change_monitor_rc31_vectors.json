            "input": "EncryptionKey=abc",
            "output": "EncryptionKey=[REDACTED]"
        },
        {
            "input": "dbPass=abc",
            "output": "dbPass=[REDACTED]"
        },
        {
            "input": "DB_PASSWORD=abc",
            "output": "DB_PASSWORD=[REDACTED]"
        },
        {
            "input": "ExecStart=/usr/bin/app --pass hunter2 --verbose",
            "output": "ExecStart=/usr/bin/app --pass [REDACTED] --verbose"
        },
        {
            "input": "ExecStart=/usr/bin/app --token abc --verbose",
            "output": "ExecStart=/usr/bin/app --token [REDACTED] --verbose"
        },
        {
            "input": "curl -X POST --api-key abc123 http://x",
            "output": "curl -X POST --api-key [REDACTED] http://x"
        },
        {
            "input": "run.sh -password \"x y\"",
            "output": "run.sh -password [REDACTED]"
