{
    "name": "rivet/rivet-core",
    "description": "Edition-neutral services shared by RivetIT and RivetMSP: audit, jobs, Redis helpers, MCP pipeline and ITSM building blocks.",
    "type": "library",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/TheTractorHacker/rivet-core",
    "support": {
        "issues": "https://github.com/TheTractorHacker/rivet-core/issues",
        "source": "https://github.com/TheTractorHacker/rivet-core"
    },
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.0 || ^8.0",
        "predis/predis": "^3.5",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "RivetCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RivetCore\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit"
    }
}
