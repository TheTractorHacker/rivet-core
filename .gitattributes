/.github        export-ignore
/tests          export-ignore
/docs           export-ignore
# The UI asset installer and checker ship in the package (editions run them from vendor/rivet/rivet-core); every other script stays dev-only.
/scripts/* export-ignore
/scripts/install-ui-assets.php -export-ignore
/scripts/check-ui-assets.php -export-ignore
/scripts/ui-assets-lib.php -export-ignore
/endpoint-agent export-ignore
/phpunit.xml.dist export-ignore
/phpstan.neon   export-ignore
/phpstan-baseline-converters.neon export-ignore
/ROADMAP.md     export-ignore
* text=auto eol=lf
